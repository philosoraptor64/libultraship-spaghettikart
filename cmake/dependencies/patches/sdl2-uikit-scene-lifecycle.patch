 @end
 
+/* UIScene life cycle (required for apps built with the iOS 27 SDK). When
+ * Info.plist declares UIApplicationSceneManifest with this class as the
+ * scene delegate, SDL_main starts once the first window scene connects and
+ * SDL windows are created on that scene. */
+#if !TARGET_OS_TV
+API_AVAILABLE(ios(13.0))
+@interface SDLUIKitSceneDelegate : UIResponder<UIWindowSceneDelegate>
+@property (nonatomic, strong) UIWindow *window;
+@end
+#endif
+
+/* The connected window scene, or nil before one connects / without scenes. */
+UIWindowScene *UIKit_GetActiveWindowScene(void) API_AVAILABLE(ios(13.0));
+SDL_bool UIKit_UsesSceneLifecycle(void);
+
 @interface SDLUIKitDelegate : NSObject<UIApplicationDelegate>
 
 + (id)sharedAppDelegate;
diff --git a/src/video/uikit/SDL_uikitappdelegate.m b/src/video/uikit/SDL_uikitappdelegate.m
index 31b114a93..e033106d3 100644
--- a/src/video/uikit/SDL_uikitappdelegate.m
+++ b/src/video/uikit/SDL_uikitappdelegate.m
@@ -349,6 +349,44 @@ - (NSUInteger)supportedInterfaceOrientations
 
 @end
 
+static UIWindowScene *active_window_scene API_AVAILABLE(ios(13.0)) = nil;
+static BOOL main_started = NO;
+
+SDL_bool UIKit_UsesSceneLifecycle(void)
+{
+    return [[NSBundle mainBundle] objectForInfoDictionaryKey:@"UIApplicationSceneManifest"] != nil ? SDL_TRUE : SDL_FALSE;
+}
+
+UIWindowScene *UIKit_GetActiveWindowScene(void)
+{
+    return active_window_scene;
+}
+
+#if !TARGET_OS_TV
+@implementation SDLUIKitSceneDelegate
+
+- (void)scene:(UIScene *)scene willConnectToSession:(UISceneSession *)session options:(UISceneConnectionOptions *)connectionOptions
+{
+    if ([scene isKindOfClass:[UIWindowScene class]]) {
+        active_window_scene = (UIWindowScene *)scene;
+    }
+    if (!main_started) {
+        main_started = YES;
+        /* Run SDL_main on the next run loop pass, as didFinishLaunching would. */
+        [[SDLUIKitDelegate sharedAppDelegate] performSelector:@selector(postFinishLaunch) withObject:nil afterDelay:0.0];
+    }
+}
+
+- (void)sceneDidDisconnect:(UIScene *)scene
+{
+    if (scene == active_window_scene) {
+        active_window_scene = nil;
+    }
+}
+
+@end
+#endif
+
 @implementation SDLUIKitDelegate {
     UIWindow *launchWindow;
 }
